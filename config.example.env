# Copy to /etc/infra-harness.env (mode 0600) or export before running.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=https://localhost
OPENROUTER_TITLE=opensuse-infra-harness

DISCORD_WEBHOOK_URL=
# Optional Discord role id mentioned only on crit
DISCORD_CRIT_ROLE_ID=

# Seconds between windows when running without --once / without systemd timer
INTERVAL_SECONDS=900

DRY_RUN=true
ALLOW_PATCHES=false
USE_SUDO=true

MAX_TOOL_ROUNDS=8
MAX_ACTIONS_PER_WINDOW=5
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET=false

# Comma-separated systemd unit names the agent may start/stop/restart
ALLOWED_UNITS=sshd.service,cron.service,nginx.service

# Comma-separated directory prefixes for read_file/write_file
ALLOWED_PATHS=/etc/infra-harness,/opt/infra-harness,/var/lib/infra-harness

DATA_DIR=/var/lib/infra-harness
PROMPT_PATH=
COMMAND_TIMEOUT_SECONDS=60
